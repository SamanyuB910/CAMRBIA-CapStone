# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.env

# Reference clones (read-only, re-clonable; pinned in configs/pins.yaml)
reference/

# Heavy assets (re-downloadable via scripts/download_assets.py)
models/
data/pile10k/
data/eval_prompts/
lenses/released/**/*.pt
lenses/ours/**/*.pt
lenses/**/*.ckpt.pt
*.ckpt.pt.tmp.*

# Local scratch
results/plumbing/

# Downloaded lexicon (pinned by url+sha256 in pins.yaml, re-fetched by `rlens download`)
data/lexicon/

# Coherence: the full readout table is large and regenerable
results/coherence_readouts_*.parquet

# Blinded-panel key: committing it would let anyone (including an LLM rater
# working from the repo) unblind the panel before rating. Keep it local until
# ratings are in, then commit deliberately with `git add -f`.
**/coherence_panel_key.jsonl
